# ========================================================
# AI Research Assistant with RAG - Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file.
# ========================================================

# --- Application Settings ---
APP_NAME="AI Research Assistant with RAG"
APP_ENV="development"
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- Security & Auth ---
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- File Storage & Upload Limits ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS="pdf,docx,txt"
UPLOAD_DIR="./data/uploads"

# --- Database & Vector Storage ---
DATABASE_URL="sqlite:///./data/research_assistant.db"
CHROMA_PERSIST_DIR="./data/chroma_db"

# --- Embedding Configuration ---
# Supports sentence-transformers (e.g. all-MiniLM-L6-v2 or local ONNX/fastembed)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# --- LLM Provider Settings ---
# Options: "gemini", "openai", "grok", "ollama", "fallback"
LLM_PROVIDER="fallback"

# Hosted Providers (Fill according to chosen provider)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

GROK_API_KEY=""
GROK_MODEL="grok-beta"

# Local Provider (Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# --- Web Research Settings ---
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=""

# --- OCR Settings ---
OCR_ENABLED=true
TESSERACT_CMD="" # Leave blank if tesseract is in PATH, or specify path e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
